---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Chroma — Selector de paletas de color',
  description = 'Crea paletas de color con una rueda cromática interactiva y armonías clásicas.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- PWA / iOS home-screen app -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Chroma" />

    {
      /* PWA manifest + service worker (only emitted in the production build) */
      import.meta.env.PROD && (
        <>
          <link rel="manifest" href="/manifest.webmanifest" />
          <script src="/registerSW.js" is:inline></script>
        </>
      )
    }

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
