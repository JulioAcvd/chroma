---
import Layout from '../layouts/Layout.astro';
import ChromaApp from '../components/ChromaApp.svelte';
---

<Layout>
  <header class="site-header">
    <div class="brand">
      <span class="dot"></span>
      <h1>Chroma</h1>
    </div>
    <p class="tagline">Rueda cromática · paletas y armonías</p>
  </header>

  <main>
    <ChromaApp client:only="svelte" />
  </main>

  <style>
    .site-header {
      max-width: 1100px;
      margin-inline: auto;
      padding: 1.6rem 1.5rem 0.5rem;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .brand h1 {
      font-size: 1.4rem;
      letter-spacing: -0.01em;
    }
    .dot {
      width: 14px;
      height: 14px;
      border-radius: 999px;
      background: conic-gradient(
        from 0deg,
        #ff4d4d,
        #ffb84d,
        #f5f54d,
        #4dff6e,
        #4dd2ff,
        #6366f1,
        #c14dff,
        #ff4d4d
      );
      box-shadow: 0 0 16px -2px rgba(99, 102, 241, 0.7);
    }
    .tagline {
      font-size: 0.78rem;
      color: var(--color-text-faint);
    }
  </style>
</Layout>
